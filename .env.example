# Copy this file to ".env" and (optionally) change the values.
#   PowerShell:  Copy-Item .env.example .env
# These are LOCAL DEVELOPMENT placeholders only. Never put real credentials in Git.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=assessment_db
DB_USER=assessment_user
DB_PASSWORD=change_me_local_only
# Optional: when both are set, the app creates this ADMIN account on first startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_only
